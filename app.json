{
  "expo": {
    "name": "ChatRoom",
    "slug": "chatroom",
    "scheme": "chatroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seuusuario.chatroom"
    },
    "android": {
      "package": "com.seuusuario.chatroom",
      "adaptiveIcon": {
        "backgroundColor": "#DBEAFE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    }
  }
}
